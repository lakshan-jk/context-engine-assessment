# ── HTTP server ────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info                 # debug | info | warn | error

# ── Upstream services ──────────────────────────────────────────
# gateway = mock (default, in-process fixtures) | http (real fetch to UPSTREAM_BASE_URL)
GATEWAY=mock
UPSTREAM_BASE_URL=http://127.0.0.1:4000
UPSTREAM_TIMEOUT_MS=800
UPSTREAM_RETRIES=2
CACHE_TTL_MS=60000

# Fault injection for the mock gateway (demonstrates graceful degradation).
# Comma-separated service names to fail: user,kundli,horoscope,panchang
MOCK_FAIL_SERVICES=
# Artificial latency (ms) added to every mock response.
MOCK_LATENCY_MS=0

# ── LLM provider ───────────────────────────────────────────────
# provider = mock (default, no key) | anthropic (needs key) | ollama (local, no key)
LLM_PROVIDER=mock

# Anthropic (cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (local daemon — real LLM, free, offline)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
